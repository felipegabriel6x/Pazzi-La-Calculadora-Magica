#Multiplicação:
def multiplicacao():
   limpar_tela()
   print("PAZZI, La Calculadora Magica")
   print("")
   print("MATRIZ - MULTIPLICAÇÃO")
   print("")
   print("Matriz A:")
   print("")

   A = []
   linhaA = int(input("Insira o número de linhas: "))
   colunaA = int(input("Insira o número de colunas: "))
